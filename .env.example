# ===============================================
# RepoPilot AI Configuration
# ===============================================

# Ollama Model Runtime (Local Inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Server & Storage
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/repopilot.db

# Execution Limits
TEST_TIMEOUT_SECONDS=30
MAX_UPLOAD_MB=50

# Security: Allowed Ollama hostnames (mitigates SSRF)
ALLOWED_OLLAMA_HOSTS=localhost,127.0.0.1,host.docker.internal
